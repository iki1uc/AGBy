// SUS.vector

export const SUSvector = {

    make(engine, build) {

        const vector = {
            hx: (engine.level * 0.7).toFixed(3),
            by: (build.vector.y * 1.1).toFixed(3),
            tz: (build.vector.z * 1.3).toFixed(3)
        }

        return {
            vector,
            status: "vector-ready"
        }
    }
}
