// core/core.state

export const coreState = {

    make(room, respo, shift) {

        let mode = "critical"

        if (respo.color === "green" && room.ok && shift.level > 2.0) mode = "stable"
        else if (respo.color === "yellow" && shift.level > 1.2) mode = "soft"

        return {
            mode,
            room: room.status,
            respo: respo.color,
            shift: shift.level,
            status: "core-state-ready"
        }
    }
}
