// SUITE/show.room

import { runRoom } from "./run.room"

export const showRoom = {

    display() {
        const result = runRoom.start()

        return {
            status: "suite‑active",
            eye: result.eye,
            scale: result.scale,
            impulse: result.impulse,
            engine: result.engine,
            target: {
                room: result.roomState,
                rom: result.romState
            }
        }
    }
}

