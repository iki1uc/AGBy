// SUITE/suite.scale

export const suiteScale = {

    adjust(eye) {

        // Flow glätten
        const flow = this.smooth(eye.flow)

        // Tiefe normalisieren
        const depth = this.normalize(eye.depth)

        // Energie stabilisieren
        const energy = this.stabilize(eye.energy)

        // Respo übernehmen (keine Skalierung)
        const respo = eye.respo

        return {
            flow,
            depth,
            energy,
            respo
        }
    },

    smooth(value) {
        // Flow wird leicht geglättet
        return (value * 0.85 + 0.15).toFixed(2)
    },

    normalize(value) {
        // Tiefe wird auf 0.0–1.0 gestreckt
        return (value / 0.8).toFixed(2)
    },

    stabilize(value) {
        // Energie wird leicht stabilisiert
        return (value * 0.9 + 0.1).toFixed(2)
    }
}

