// WHIRL.root.mirror – Spiegelung des WHIRL-Root-Baums

import { WHIRL } from "./WHIRL.js";

export const WHIRL_root_mirror = {

  MOD: "WHIRL.root.mirror",
  TYPE: "mirror",
  VERSION: "1.0",

  mirror() {
    return {
      axis: { ...WHIRL.root.axis },
      mode: WHIRL.mode,
      qi: WHIRL.QI,
      iqq: WHIRL.IQQ,
      status: "mirror-ready"
    };
  }
};
